# SQLite (개발 기본값)
DATABASE_URL=sqlite:///./mini_chatbot.db
# PostgreSQL (운영 전환 시 — psycopg2-binary 설치 필요)
# DATABASE_URL=postgresql://user:password@localhost:5432/mindflow

DATABASE_ECHO=false
